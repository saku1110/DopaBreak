{
  "sourceLanguage": "ja",
  "strings": {
    "usage_watch.notification.action.mute_today": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Mute for today" } },
        "ja": { "stringUnit": { "state": "translated", "value": "今日は止める" } },
        "ko": { "stringUnit": { "state": "translated", "value": "오늘은 그만 알리기" } }
      }
    },
    "usage_watch.notification.free_warning.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Did you find what you were looking for?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "見ようとしていたものは見つかりましたか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "보려던 걸 찾았나요?" } }
      }
    },
    "usage_watch.notification.free_warning.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "2 hours straight ⏰" } },
        "ja": { "stringUnit": { "state": "translated", "value": "連続で2時間になりました⏰" } },
        "ko": { "stringUnit": { "state": "translated", "value": "연속 2시간째예요 ⏰" } }
      }
    },
    "usage_watch.notification.hourly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What did this hour leave you with? 💭" } },
        "ja": { "stringUnit": { "state": "translated", "value": "この1時間で何が残りましたか？💭" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 1시간 동안 뭐가 남았나요? 💭" } }
      }
    },
    "usage_watch.notification.hourly.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Another hour just passed" } },
        "ja": { "stringUnit": { "state": "translated", "value": "また1時間たちました" } },
        "ko": { "stringUnit": { "state": "translated", "value": "또 1시간이 지났어요" } }
      }
    },
    "usage_watch.notification.q15.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Still scrolling?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "SNSをまだ見ますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "아직 더 볼 거예요?" } }
