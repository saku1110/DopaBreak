diff --git a/ios/DopaBreak/GrayscaleAutomationGuideView.swift b/ios/DopaBreak/GrayscaleAutomationGuideView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d12401985b68ac324ff9c096a97c9a914f9a366c
--- /dev/null
+++ b/ios/DopaBreak/GrayscaleAutomationGuideView.swift
@@ -0,0 +1,140 @@
+import DopaBreakCore
+import SwiftUI
+import UIKit
+
+/// 画面を自動でモノクロにする設定ガイド（doc11 §4e）。
+/// 設定完了はiOSの仕様上検知できないため手順ガイドのみで案内する。
+struct GrayscaleAutomationGuideView: View {
+    let model: AppModel
+    let settingsStore: SettingsStore
+
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 22) {
+                    Text("画面を自動でモノクロにする設定")
+                        .font(.system(size: 28, weight: .black))
+                        .foregroundStyle(DesignTokens.primaryText)
+
+                    Text("ショートカットのオートメーションで 起床・就寝の時刻に合わせて画面の色を自動で切り替えます")
+                        .font(.system(size: 15, weight: .semibold))
+                        .foregroundStyle(DesignTokens.secondaryText)
+                        .lineSpacing(4)
+
+                    Button("ショートカットを開く") {
+                        openShortcutsApp()
+                    }
+                    .buttonStyle(PrimaryButtonStyle())
+
+                    CardContainer {
+                        VStack(alignment: .leading, spacing: 8) {
+                            SmallLabel(text: "なぜモノクロ?")
+                            Text("色のない画面はSNSへの反応を弱めると言われています")
+                                .font(.system(size: 15, weight: .semibold))
+                                .foregroundStyle(DesignTokens.secondaryText)
+                                .lineSpacing(4)
+                        }
+                    }
+
+                    if let wakeTimeText, let bedTimeText {
+                        automationStepsCard(
+                            title: "就寝時刻にモノクロにする",
+                            steps: [
+                                "オートメーションを開く",
+                                "＋を押して時刻を選ぶ",
+                                "就寝時刻 \(bedTimeText) を設定",
+                                "すぐに実行を選ぶ（確認を求めるはオフ）",
+                                "アクションでカラーフィルタを設定を選びモノクロをオンにする"
+                            ]
+                        )
+
+                        automationStepsCard(
+                            title: "起床時刻にモノクロを解除する",
+                            steps: [
+                                "オートメーションを開く",
+                                "＋を押して時刻を選ぶ",
+                                "起床時刻 \(wakeTimeText) を設定",
+                                "すぐに実行を選ぶ（確認を求めるはオフ）",
+                                "モノクロをオフにする"
+                            ]
+                        )
+                    } else {
+                        CardContainer {
+                            Text("先に起床・就寝時刻を設定してください")
+                                .font(.system(size: 15, weight: .semibold))
+                                .foregroundStyle(DesignTokens.secondaryText)
+                        }
+                    }
+
+                    Text("設定完了はiOSの仕様上確認できません。設定後は実際に時刻を待って確認してください。")
+                        .font(.system(size: 14, weight: .medium))
+                        .foregroundStyle(DesignTokens.secondaryText)
+                        .lineSpacing(4)
+                }
+                .padding(.horizontal, 20)
+                .padding(.top, 24)
+                .padding(.bottom, 60)
+            }
+            .dopaScreenBackground()
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .topBarTrailing) {
+                    Button("閉じる") {
+                        dismiss()
+                    }
+                    .foregroundStyle(DesignTokens.secondaryText)
+                }
+            }
+        }
+        .tint(DesignTokens.accent)
+        .preferredColorScheme(.dark)
+    }
+
+    private var wakeTimeText: String? {
+        settingsStore.wakeTimeMinutes.map(timeText)
+    }
+
+    private var bedTimeText: String? {
+        settingsStore.bedTimeMinutes.map(timeText)
+    }
+
+    private func automationStepsCard(title: String, steps: [String]) -> some View {
+        CardContainer {
+            VStack(alignment: .leading, spacing: 14) {
+                SmallLabel(text: title)
+                ForEach(Array(steps.enumerated()), id: \.offset) { offset, step in
+                    numberedStep(offset + 1, step)
+                }
+            }
+        }
+    }
+
+    private func numberedStep(_ index: Int, _ text: String) -> some View {
+        HStack(alignment: .top, spacing: 10) {
+            Text("\(index)")
+                .font(.system(size: 13, weight: .black))
+                .foregroundStyle(DesignTokens.background)
+                .frame(width: 22, height: 22)
+                .background(DesignTokens.accent)
+                .clipShape(Circle())
+
+            Text(text)
+                .font(.system(size: 16, weight: .semibold))
+                .foregroundStyle(DesignTokens.primaryText)
+        }
+    }
+
+    private func timeText(minutes: Int) -> String {
+        let normalized = ((minutes % 1_440) + 1_440) % 1_440
+        return String(format: "%02d:%02d", normalized / 60, normalized % 60)
+    }
+
+    private func openShortcutsApp() {
+        guard let url = URL(string: "shortcuts://") else {
+            return
+        }
+        UIApplication.shared.open(url)
+    }
+}
