    58	    }
    59	
    60	    private func resolve(nowMinutes: Int, wakeMinutes: Int?, bedMinutes: Int?) -> DayTimeContext {
    61	        DayTimeContext.resolve(
    62	            now: date(minutes: nowMinutes),
    63	            wakeMinutes: wakeMinutes,
    64	            bedMinutes: bedMinutes,
    65	            calendar: calendar
    66	        )
    67	    }
    68	
    69	    private func date(minutes: Int) -> Date {
    70	        DateComponents(
    71	            calendar: calendar,
    72	            timeZone: calendar.timeZone,
    73	            year: 2026,
    74	            month: 7,
    75	            day: 9,
    76	            hour: minutes / 60,
    77	            minute: minutes % 60
    78	        ).date!
    79	    }
    80	}

