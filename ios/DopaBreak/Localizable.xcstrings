    "automation_guide.grayscale.label": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Deep Focus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Focus向け"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Focus용"
          }
        }
      }
    },
    "automation_guide.grayscale.lead": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing color from social media reduces stimulation and weakens its pull to keep you watching. This optional setting pairs well with Deep Focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SNSから色を消すと刺激が減り、見続ける力が弱まります。Deep Focusと相性のいい追加設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SNS에서 색을 없애면 자극이 줄어 계속 보고 싶은 마음도 약해집니다. Deep Focus와 잘 맞는 추가 설정이에요."
          }
        }
      }
    },
    "automation_guide.grayscale.manual": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you prefer not to automate it: Go to Settings → Accessibility → Accessibility Shortcut → Color Filters and turn it on. After that, triple-click the side button (or the Home button on models that have one) to switch between grayscale and color."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化しない場合: 設定→アクセシビリティ→ショートカット→カラーフィルタをオン。以後サイドボタン（ホームボタンがある機種はホームボタン）を3回押すと、白黒とカラーを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화하지 않는 경우: 설정 → 손쉬운 사용 → 손쉬운 사용 단축키 → 색상 필터를 켜세요. 이후 측면 버튼(홈 버튼이 있는 모델은 홈 버튼)을 세 번 눌러 흑백 화면과 컬러 화면을 전환할 수 있어요."
          }
        }
      }
    },
    "automation_guide.grayscale.mock.apps": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
