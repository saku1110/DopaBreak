   460	    private func assertJSONRoundTrip<Value: Codable & Equatable>(
   461	        _ value: Value,
   462	        file: StaticString = #filePath,
   463	        line: UInt = #line
   464	    ) throws {
   465	        let encoder = JSONEncoder()
   466	        encoder.dateEncodingStrategy = .iso8601
   467	        let data = try encoder.encode(value)
   468	
   469	        let decoder = JSONDecoder()
   470	        decoder.dateDecodingStrategy = .iso8601
   471	        XCTAssertEqual(try decoder.decode(Value.self, from: data), value, file: file, line: line)
   472	    }
