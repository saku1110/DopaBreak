    private var morningNotificationBinding: Binding<Bool> {
        Binding(
            get: { morningNotificationEnabled },
            set: { value in
                morningNotificationEnabled = value
                settingsStore.morningNotificationEnabled = value
                model.refreshLockSurfaces()
            }
        )
    }

