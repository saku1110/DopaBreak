    "onboarding.science.research": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a peer-reviewed study of one sec (PNAS, 2023), participants who continued for six weeks opened their target apps 57% less often on average."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "one secを使った査読付き研究（PNAS, 2023）では、6週間継続した参加者が対象アプリを実際に開いた回数が平均57%減少しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "one sec의 동료 심사 연구(PNAS, 2023)에서 6주간 사용을 지속한 참가자들은 대상 앱을 실제로 연 횟수가 평균 57% 감소했습니다."
          }
        }
      }
    },
