    "settings.deep_focus.description": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps won't open for the times you set. Start now or set a weekly schedule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリは決めた時間だけ開けなくなります いますぐ始めるか毎週の予定を設定できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱은 정한 시간 동안 열 수 없어요. 지금 시작하거나 매주 예약을 설정할 수 있어요"
          }
        }
      }
    },
