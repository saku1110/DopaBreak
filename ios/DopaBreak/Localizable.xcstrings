    "settings.strict.exit.countdown": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除まであと%lld秒"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit available in %lld seconds"
          }
