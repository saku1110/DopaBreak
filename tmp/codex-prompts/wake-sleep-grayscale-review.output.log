     8	        calendar.timeZone = TimeZone(secondsFromGMT: 0)!
     9	        return calendar
    10	    }
    11	
    12	    func testNoWakeOrBedTimeReturnsNormal() {
    13	        XCTAssertEqual(resolve(nowMinutes: 0, wakeMinutes: nil, bedMinutes: nil), .normal)
    14	        XCTAssertEqual(resolve(nowMinutes: 720, wakeMinutes: nil, bedMinutes: nil), .normal)
    15	        XCTAssertEqual(resolve(nowMinutes: 1_439, wakeMinutes: nil, bedMinutes: nil), .normal)
    16	    }
    17	
    18	    func testWakeWindowIncludesStart() {
    19	        XCTAssertEqual(resolve(nowMinutes: 420, wakeMinutes: 420, bedMinutes: nil), .wake)
    20	    }
    21	
