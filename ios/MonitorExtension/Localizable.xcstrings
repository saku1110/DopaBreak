    "usage_watch.notification.q15.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "15 minutes in" } },
        "ja": { "stringUnit": { "state": "translated", "value": "15分たちました" } },
        "ko": { "stringUnit": { "state": "translated", "value": "15분 지났어요" } }
      }
    },
    "usage_watch.notification.q30.body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Got what you came for? 👀" } },
        "ja": { "stringUnit": { "state": "translated", "value": "SNSで満足感を得られましたか？👀" } },
        "ko": { "stringUnit": { "state": "translated", "value": "충분히 만족했나요? 👀" } }
