    "paywall.header.body": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't an app about willpower. It just adds one breath before you open. Every time you turn back, it stacks up on your Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "がんばって我慢するアプリではありません。開く前に毎回ひと呼吸が入るだけ。開かずに戻れた回数が毎日ホームに積み上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억지로 참는 앱이 아닙니다. 열기 전에 한 번 숨을 고르는 순간이 생길 뿐입니다. 열지 않고 돌아선 횟수가 매일 홈에 쌓입니다."
          }
        }
      }
    },
    "paywall.header.line1.prefix": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Just 5 more min” ="
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あと5分だけ」が年"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「5분만 더」가 1년에"
          }
        }
      }
    },
    "paywall.header.line1.suffix": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
