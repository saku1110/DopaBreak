    "automation_guide.grayscale.note": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action and trigger names may vary by iOS version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション名・トリガー名はiOSのバージョンで表記が変わることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 이름과 트리거 이름은 iOS 버전에 따라 다르게 표시될 수 있어요."
          }
        }
      }
    },
    "automation_guide.grayscale.section": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your screen grayscale (optional)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を白黒にする（任意）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 흑백으로 바꾸기(선택)"
          }
        }
      }
    },
    "automation_guide.grayscale.step.1": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new automation, choose “App,” select all target apps, pick “Is Opened” and “Run Immediately,” then tap Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規オートメーションで「アプリ」を選び、対象アプリをまとめて全部選んで「開いている」と「すぐに実行」を選び「次へ」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 자동화에서 ‘앱’을 선택하고 대상 앱을 한꺼번에 모두 선택한 다음 ‘열릴 때’와 ‘즉시 실행’을 선택하고 ‘다음’을 누르세요"
          }
        }
      }
    },
    "automation_guide.grayscale.step.2": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the “Set Color Filters” action, set it to On, and finish"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション「カラーフィルタを設定」を選び「オン」にして完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘색상 필터 설정’ 동작을 선택해 ‘켬’으로 설정하고 완료하세요"
          }
        }
      }
    },
    "automation_guide.grayscale.step.3": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one more automation for “Is Closed,” select the same apps, and set “Set Color Filters” to Off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう1つ作り「閉じている」で同じアプリを選び「カラーフィルタを設定」を「オフ」にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화를 하나 더 만들고 ‘닫힐 때’에서 같은 앱을 선택한 다음 ‘색상 필터 설정’을 ‘끔’으로 설정하세요"
          }
        }
      }
    },
