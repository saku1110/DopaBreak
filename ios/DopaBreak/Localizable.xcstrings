    "grayscale_guide.lead": {
      "comment": "Screen: Grayscale guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing color takes the edge off the moment you open an app. With a Shortcuts automation, your screen turns grayscale only while your chosen apps are open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面から色をなくすと、アプリを開いたときの刺激が弱まります。ショートカットのオートメーションを使うと、対象アプリを開いたときだけ自動で白黒にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색을 없애면 앱을 열었을 때의 자극이 약해져요. 단축어 자동화를 쓰면 선택한 앱을 열 때만 화면이 흑백으로 바뀌어요."
          }
        }
      }
    },
