    32	    }
    33	
    34	    func testSleepWindowExcludesEnd() {
    35	        XCTAssertEqual(resolve(nowMinutes: 1_380, wakeMinutes: nil, bedMinutes: 1_380), .normal)
    36	    }
    37	
    38	    func testWakeWindowWrapsAcrossMidnight() {
    39	        XCTAssertEqual(resolve(nowMinutes: 10, wakeMinutes: 1_430, bedMinutes: nil), .wake)
    40	    }
    41	
    42	    func testWakeWindowAtMidnightDoesNotIncludePreviousDay() {
    43	        XCTAssertEqual(resolve(nowMinutes: 1_430, wakeMinutes: 0, bedMinutes: nil), .normal)
    44	    }
    45	
    46	    func testWakeWindowAtMidnightUsesThirtyMinuteHalfOpenRange() {
    47	        XCTAssertEqual(resolve(nowMinutes: 29, wakeMinutes: 0, bedMinutes: nil), .wake)
    48	        XCTAssertEqual(resolve(nowMinutes: 30, wakeMinutes: 0, bedMinutes: nil), .normal)
    49	    }
