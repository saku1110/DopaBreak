    "settings.authorization.body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time blocks apps during the hours you choose. Your usage data stays on your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決めた時間はスクリーンタイムでアプリを完全にブロックします。利用データは端末内だけに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 시간에는 스크린 타임으로 앱을 완전히 차단해요. 이용 데이터는 기기에만 저장돼요."
          }
        }
      }
    },
    "settings.authorization.denied_body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time permission is required to block apps on a schedule. You can allow it anytime in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯の完全ブロックにはスクリーンタイムの許可が必要です。iPhoneの設定からいつでも許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간에 앱을 완전히 차단하려면 스크린 타임 권한이 필요해요. iPhone 설정에서 언제든 허용할 수 있어요."
          }
        }
      }
    },
    "settings.authorization.title": {
