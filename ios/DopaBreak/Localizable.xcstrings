    "automation_guide.grayscale.label": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Deep Focus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Focus向け"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
