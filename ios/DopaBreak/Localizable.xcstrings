    "home.automation_status.body": {
      "comment": "Screen: Home",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is complete when the pause screen appears after you open a selected app."
          }
