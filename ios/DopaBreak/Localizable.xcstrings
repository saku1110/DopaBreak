    "onboarding.automation.privacy_note": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak only sees that you opened one of your chosen apps. Nothing else you tap or see is sent to it."
