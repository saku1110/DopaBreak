        )
    }

    private var bedTimeBinding: Binding<Date> {
        Binding(
            get: { dateForTime(minutes: settingsStore.bedTimeMinutes, defaultMinutes: 1_380) },
            set: { settingsStore.bedTimeMinutes = minutes(from: $0) }
        )
    }

