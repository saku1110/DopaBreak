    "settings.gate.category_note": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Category selections apply only to Full Block. Set the pause separately for each app." } },
        "ja": { "stringUnit": { "state": "translated", "value": "カテゴリ単位の選択は、完全ブロックにだけ適用されます。開く前の一呼吸はアプリごとに設定してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "카테고리 선택은 완전 차단에만 적용돼요. 열기 전 숨 고르기는 앱마다 따로 설정해 주세요." } }
      }
    },
    "settings.gate.locked_notice": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "With Pro, you can pause before opening without Shortcuts. You can also set daily limits and wait times." } },
