      }
    },
    "settings.gate.automation_note": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pro's paused apps don't need a Shortcuts automation." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Proの止めるアプリではショートカットの自動化は不要です" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Pro의 멈출 앱에는 단축어 자동화가 필요하지 않아요" } }
      }
    },
    "settings.gate.category_note": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Category selections are used only for full blocking. The pause before opening works per app." } },
        "ja": { "stringUnit": { "state": "translated", "value": "カテゴリ選択は完全ブロックでだけ使われます。開く前の一呼吸はアプリ単位です" } },
        "ko": { "stringUnit": { "state": "translated", "value": "카테고리 선택은 완전 차단에만 사용돼요. 열기 전 한 호흡은 앱 단위로 작동해요" } }
      }
    },
    "settings.gate.locked_notice": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "With Pro you can always pause before opening without a Shortcuts setup and set limits and wait times." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Proにするとショートカット設定なしで開く前に必ず止まり回数や待ち時間も決められます" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Pro에서는 단축어 설정 없이 열기 전에 항상 멈추고 횟수와 대기 시간도 정할 수 있어요" } }
      }
    },
