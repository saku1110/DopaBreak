   568	    private func utcCalendar() -> Calendar {
   569	        var calendar = Calendar(identifier: .gregorian)
   570	        calendar.timeZone = TimeZone(secondsFromGMT: 0)!
   571	        return calendar
   572	    }
   573	
   574	    private func calendarDate(
   575	        year: Int,
   576	        month: Int,
   577	        day: Int,
   578	        hour: Int,
   579	        minute: Int = 0,
   580	        second: Int = 0
   581	    ) -> Date {
   582	        var components = DateComponents()
   583	        components.calendar = utcCalendar()
   584	        components.timeZone = TimeZone(secondsFromGMT: 0)
   585	        components.year = year
   586	        components.month = month
   587	        components.day = day
   588	        components.hour = hour
   589	        components.minute = minute
   590	        components.second = second
   591	        return components.date!
   592	    }
