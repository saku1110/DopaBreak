    "settings.strict.change_blocked": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強いブロック中は変更できません。必要な場合は、セッションの解除から緊急解除してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are disabled during a strict session. If needed, use the session exit button to request an emergency exit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강한 차단 중에는 변경할 수 없습니다. 필요한 경우 세션 해제 버튼에서 긴급 해제를 요청하세요."
          }
        }
      }
    },
    "settings.strict.description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了まで通常の解除と対象・モードの変更を止めます。緊急解除には30秒の待機が必要です。iOS設定での権限取り消しは防げません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until the session ends, regular exits and changes to targets or mode are disabled. Emergency exit requires a 30-second wait. This cannot prevent revoking permission in iOS Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시각까지 일반 해제와 대상·모드 변경이 제한됩니다. 긴급 해제 시 30초 대기가 필요합니다. iOS 설정에서 권한을 취소하는 것은 막을 수 없습니다."
          }
        }
      }
    },
    "settings.strict.exit.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動セッションを緊急解除"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End manual session now"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 세션 긴급 해제"
          }
        }
      }
    },
    "settings.strict.exit.continue": {
