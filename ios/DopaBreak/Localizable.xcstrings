    "paywall.header.body": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a willpower app. It just adds one breath before you open. Every time you choose not to open, it stacks up on your Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "がんばって我慢するアプリではありません。開く前に毎回ひと呼吸が入るだけ。開くのをやめた回数が毎日ホームに積み上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억지로 참는 앱이 아닙니다. 열기 전에 매번 잠깐 브레이크가 걸릴 뿐입니다. 열지 않기로 한 횟수가 매일 홈에 쌓입니다."
          }
        }
      }
    },
