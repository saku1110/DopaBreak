    "paywall.header.body": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't about forcing yourself to resist. DopaBreak adds a quick pause before social media opens and records each time you decide not to open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ずっと我慢するためのアプリではありません。SNSを開く前に一呼吸はさみ、開かずにすんだ回数をホームに残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억지로 참게 하는 앱이 아니에요. SNS를 열기 전에 잠깐 숨을 고를 시간을 만들고, 열지 않은 횟수를 홈에 기록해요."
          }
        }
      }
    },
