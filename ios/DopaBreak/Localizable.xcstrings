        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリを開き、一呼吸の画面が表示されれば設定完了です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱을 열었을 때 숨 고르기 화면이 뜨면 설정 완료예요."
          }
        }
      }
    },
