     1	import Foundation
     2	
     3	public enum DayTimeContext: Equatable, Sendable {
     4	    case wake
     5	    case sleep
     6	    case normal
     7	
     8	    private static let minutesPerDay = 1_440
     9	    private static let wakeWindowLengthMinutes = 30
    10	    private static let sleepWindowLengthMinutes = 60
    11	
    12	    public static func resolve(
    13	        now: Date,
    14	        wakeMinutes: Int?,
    15	        bedMinutes: Int?,
    16	        calendar: Calendar = .current
    17	    ) -> DayTimeContext {
    18	        guard wakeMinutes != nil || bedMinutes != nil else {
    19	            return .normal
    20	        }
    21	
    22	        let components = calendar.dateComponents([.hour, .minute], from: now)
    23	        let nowMinutes = ((components.hour ?? 0) * 60) + (components.minute ?? 0)
    24	
    25	        if let wakeMinutes, isInWakeWindow(nowMinutes: nowMinutes, wakeMinutes: wakeMinutes) {
    26	            return .wake
    27	        }
    28	
    29	        if let bedMinutes,
    30	           isInWindow(
    31	               nowMinutes,
    32	               start: bedMinutes - sleepWindowLengthMinutes,
    33	               lengthMinutes: sleepWindowLengthMinutes
    34	           ) {
    35	            return .sleep
    36	        }
    37	
    38	        return .normal
    39	    }
    40	
    41	    private static func isInWakeWindow(nowMinutes: Int, wakeMinutes: Int) -> Bool {
    42	        isInWindow(nowMinutes, start: wakeMinutes, lengthMinutes: wakeWindowLengthMinutes)
    43	    }
    44	
    45	    private static func isInWindow(_ nowMinutes: Int, start: Int, lengthMinutes: Int) -> Bool {
    46	        guard lengthMinutes > 0 else {
    47	            return false
    48	        }
    49	        if lengthMinutes >= minutesPerDay {
    50	            return true
    51	        }
    52	
    53	        let normalizedStart = normalizedMinutes(start)
    54	        let elapsed = normalizedMinutes(nowMinutes - normalizedStart)
    55	        return elapsed < lengthMinutes
    56	    }
    57	
    58	    private static func normalizedMinutes(_ value: Int) -> Int {
    59	        ((value % minutesPerDay) + minutesPerDay) % minutesPerDay
    60	    }
    61	}

