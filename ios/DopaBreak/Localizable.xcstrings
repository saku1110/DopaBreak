    "settings.authorization.body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak uses Screen Time to show a pause before selected apps open. Usage data stays on your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリを開く前に一呼吸の画面を表示するため、スクリーンタイムを使います。利用データはこの端末だけに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱을 열기 전에 숨 고르기 화면을 띄우기 위해 스크린 타임을 사용해요. 이용 데이터는 기기에만 저장돼요."
          }
        }
      }
    },
    "settings.authorization.denied_body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pause before opening won't work without Screen Time permission. You can allow it anytime in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムが許可されていないため、開く前の一呼吸を利用できません。iPhoneの設定からいつでも許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 권한이 없으면 열기 전 숨 고르기를 사용할 수 없어요. 설정에서 언제든 허용할 수 있어요."
          }
        }
      }
    },
    "settings.authorization.title": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
