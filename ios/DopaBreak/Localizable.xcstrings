    "automation_guide.step.1": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Automation at the bottom of the Shortcuts app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを開き、画面下部の「オートメーション」を選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 앱 하단에서 ‘자동화’를 선택하세요"
          }
        }
      }
    },
    "automation_guide.step.2": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + in the top right to create a new automation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋を押し、新規オートメーションを作る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 상단의 +를 눌러 새로운 자동화를 만드세요"
          }
        }
      }
    },
    "automation_guide.step.3": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリ」を選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘앱’을 선택하세요"
          }
        }
      }
    },
    "automation_guide.step.4": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a target app, select Is Opened and Run Immediately, leave Notify When Run off, then tap Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリと「開いている」「すぐに実行」を選ぶ。「実行時に通知」はオフのまま「次へ」をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱을 선택하고 ‘열릴 때’와 ‘즉시 실행’을 선택한 다음 ‘실행 시 알림’은 끈 상태로 두고 ‘다음’을 탭하세요"
          }
        }
      }
    },
    "automation_guide.step.5": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Create New Shortcut”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新規ショートカットを作成」をタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘새로운 단축어 생성’을 탭하세요"
          }
        }
      }
    },
    "automation_guide.step.6": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app list at the bottom of the sheet, choose DopaBreak, then “Take a breath with DopaBreak” (you can also search)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シート下部のアプリ一覧から「DopaBreak」を開き、「DopaBreakで一呼吸」を選ぶ。見つからない場合は検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트 하단의 앱 목록에서 ‘DopaBreak’를 선택한 다음 ‘DopaBreak로 숨 고르기’를 선택하세요(검색도 가능)"
          }
        }
      }
    },
    "automation_guide.step.7": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the action, choose your target under “App,” then tap the checkmark in the top right. If you have only one target app, you can leave “App” blank."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションの「アプリ」で対象アプリを選び、右上のチェックマークをタップすれば完了です。対象が1つだけなら、アプリは選ばなくても動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작의 ‘앱’에서 대상 앱을 고른 뒤 오른쪽 위 체크 표시를 누르면 끝나요. 대상 앱이 하나뿐이라면 앱을 선택하지 않아도 작동해요."
          }
        }
      }
    },
    "automation_guide.step.accessibility_label": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld %@"
          }
        },
        "ja": {
          "stringUnit": {
