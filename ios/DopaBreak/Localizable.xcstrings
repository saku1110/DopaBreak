    },
    "onboarding.science.dopamine": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social apps use unpredictable rewards—the same basic loop as a slot machine. Because you never know what comes next, checking can become automatic. Willpower alone isn't always enough to stop the reflex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SNSでは、次に何が出るかわからない仕組みが、つい続きを見たくなる気持ちを生みます。スロットマシンと同じ「変動報酬」です。だから、意志だけで開かないようにするのは簡単ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SNS는 다음에 무엇이 나올지 모르는 보상 구조를 써요. 슬롯머신과 같은 ‘변동 보상’이에요. 그래서 의지만으로 무심코 여는 습관을 멈추기는 쉽지 않아요."
          }
        }
      }
    },
    "onboarding.science.eyebrow": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / The science"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / 科学的背景"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / 과학적 배경"
          }
        }
      }
    },
    "onboarding.science.lead": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening on reflex doesn't mean you're weak. Social apps are engineered to trigger that tap before you think."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つい開いてしまうのは、あなたが弱いからではありません。SNSは、考える前に開きたくなる仕組みでできています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무심코 앱을 여는 건 당신이 약해서가 아니에요. SNS는 생각하기도 전에 손이 가도록 설계돼 있어요."
          }
        }
      }
    },
    "onboarding.science.mechanism": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak adds a brief pause right before social media opens, giving you a chance to choose instead of acting automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreakはSNSが開く直前に一呼吸をはさみ、無意識の動きを自分で選び直すきっかけをつくります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak는 SNS가 열리기 직전에 잠깐 숨을 고를 시간을 만들어, 무심코 열던 행동을 다시 선택하게 도와줘요."
          }
        }
      }
    },
    "onboarding.science.principle1.detail": {
