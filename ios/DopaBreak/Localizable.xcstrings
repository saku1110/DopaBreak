    "onboarding.science.research": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A brief pause before opening was shown to cut social media use by 57% on average in a peer-reviewed study (PNAS, 2023)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く前にワンクッション置く手法は、査読付き研究（PNAS, 2023）でSNS利用を平均57%減らすことが示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기 전에 한 박자 두는 방법은 동료 심사 연구(PNAS, 2023)에서 SNS 사용을 평균 57% 줄이는 것으로 나타났습니다."
          }
        }
      }
    },
    "onboarding.science.title": {
