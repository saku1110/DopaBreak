   452	    @MainActor
   453	    private func requestScreenTimeAuthorization() async {
   454	        guard !isRequestingAuthorization else {
   455	            return
   456	        }
   457	
   458	        isRequestingAuthorization = true
   459	        defer { isRequestingAuthorization = false }
   460	
   461	        let granted = await model.screenTime.requestAuthorization()
   462	        if granted {
   463	            model.syncShield()
   464	            isAuthorizationSheetPresented = false
   465	        } else {
   466	            authorizationWasDenied = true
   467	        }
   468	    }
