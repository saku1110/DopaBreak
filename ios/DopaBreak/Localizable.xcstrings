    "lock_check.lead.blocked": {
      "comment": "Screen: Lock Screen Check",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Activities in Settings to show it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の設定でライブアクティビティをオンにすると出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 설정에서 실시간 현황을 켜면 표시할 수 있어요."
          }
        }
      }
    },
    "lock_check.lead.confirmed": {
      "comment": "Screen: Lock Screen Check",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your goal is the first thing you see whenever you try to open a selected app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリを開こうとするたび、目標が先に目に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱을 열려고 할 때마다 목표가 먼저 보여요."
          }
        }
      }
    },
    "lock_check.lead.failed": {
      "comment": "Screen: Lock Screen Check",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again—it may appear this time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度出すと表示できることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 더 시도하면 표시될 수 있어요."
          }
        }
      }
    },
    "lock_check.lead.no_goal": {
      "comment": "Screen: Lock Screen Check",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a goal and it can show on your Lock Screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を設定すると、ロック画面に表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 정하면 잠금 화면에 띄울 수 있어요."
          }
        }
      }
    },
    "lock_check.permission_note": {
      "comment": "Screen: Lock Screen Check",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time it shows up, iOS asks whether to allow it. Choose Allow and it stays on your Lock Screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回はライブアクティビティの許可を求められます。「許可」を選ぶと、目標がロック画面に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 표시될 때 iOS에서 허용 여부를 물어봐요. ‘허용’을 고르면 잠금 화면에 계속 표시돼요."
          }
        }
      }
    },
    "live_activity.goal.eyebrow": {
      "comment": "Live Activity goal heading",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your goal" } },
        "ja": { "stringUnit": { "state": "translated", "value": "あなたの目標" } },
        "ko": { "stringUnit": { "state": "translated", "value": "나의 목표" } }
      }
