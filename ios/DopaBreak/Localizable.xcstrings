    "settings.authorization.body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use Screen Time to show one breath before you open selected apps. Usage data stays on your device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリを開く前に一呼吸を出すためスクリーンタイムを使います 利用データは端末内に保存されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱을 열기 전에 한 호흡을 띄우기 위해 스크린 타임을 사용해요. 이용 데이터는 기기 안에 저장돼요"
          }
        }
      }
    },
    "settings.authorization.denied_body": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One breath before opening is unavailable without Screen Time permission. You can grant permission anytime in Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムを許可していないため開く前の一呼吸を使えません 設定からいつでも許可できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 권한이 없어 열기 전 한 호흡을 사용할 수 없어요. 설정에서 언제든 허용할 수 있어요"
          }
        }
      }
    },
    "settings.authorization.title": {
      "comment": "Screen: Settings",
