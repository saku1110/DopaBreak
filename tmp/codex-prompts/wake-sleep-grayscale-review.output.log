   104	        CardContainer {
   105	            VStack(alignment: .leading, spacing: 14) {
   106	                SmallLabel(text: title)
   107	                ForEach(Array(steps.enumerated()), id: \.offset) { offset, step in
   108	                    numberedStep(offset + 1, step)
   109	                }
   110	            }
   111	        }
   112	    }
   113	
   114	    private func numberedStep(_ index: Int, _ text: String) -> some View {
   115	        HStack(alignment: .top, spacing: 10) {
   116	            Text("\(index)")
   117	                .font(.system(size: 13, weight: .black))
   118	                .foregroundStyle(DesignTokens.background)
   119	                .frame(width: 22, height: 22)
   120	                .background(DesignTokens.accent)
   121	                .clipShape(Circle())
   122	
   123	            Text(text)
   124	                .font(.system(size: 16, weight: .semibold))
   125	                .foregroundStyle(DesignTokens.primaryText)
   126	        }
   127	    }
   128	
   129	    private func timeText(minutes: Int) -> String {
   130	        let normalized = ((minutes % 1_440) + 1_440) % 1_440
   131	        return String(format: "%02d:%02d", normalized / 60, normalized % 60)
   132	    }
   133	
   134	    private func openShortcutsApp() {
   135	        guard let url = URL(string: "shortcuts://") else {
   136	            return
   137	        }
   138	        UIApplication.shared.open(url)
   139	    }
   140	}

