          }
        }
      }
    },
    "paywall.legal.annual_intro": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your %@ free trial, it auto-renews at %@/year. Cancel anytime. Billed to your Apple ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の無料期間終了後、年額%@で自動更新。いつでも解約できます。購入はApple IDに請求されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 무료 체험 종료 후 연 %@로 자동 갱신됩니다. 언제든 해지할 수 있습니다. Apple ID로 청구됩니다"
          }
        }
      }
    },
    "paywall.legal.auto_renew": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unless canceled, it renews at the end of the period\nBilled to your Apple ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約しない場合、期間終了時に自動更新されます\n購入はApple IDに請求されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해지하지 않으면 기간 종료 시 자동 갱신됩니다\nApple ID로 청구됩니다"
          }
        }
      }
    },
