diff --git a/ios/Packages/DopaBreakCore/Tests/DopaBreakCoreTests/DayTimeContextTests.swift b/ios/Packages/DopaBreakCore/Tests/DopaBreakCoreTests/DayTimeContextTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4c1a8e471930676144e826f6baed0c119149e87a
--- /dev/null
+++ b/ios/Packages/DopaBreakCore/Tests/DopaBreakCoreTests/DayTimeContextTests.swift
@@ -0,0 +1,71 @@
+import Foundation
+import XCTest
+@testable import DopaBreakCore
+
+final class DayTimeContextTests: XCTestCase {
+    private var calendar: Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+        return calendar
+    }
+
+    func testNoWakeOrBedTimeReturnsNormal() {
+        XCTAssertEqual(resolve(nowMinutes: 0, wakeMinutes: nil, bedMinutes: nil), .normal)
+        XCTAssertEqual(resolve(nowMinutes: 720, wakeMinutes: nil, bedMinutes: nil), .normal)
+        XCTAssertEqual(resolve(nowMinutes: 1_439, wakeMinutes: nil, bedMinutes: nil), .normal)
+    }
+
+    func testWakeWindowIncludesStart() {
+        XCTAssertEqual(resolve(nowMinutes: 420, wakeMinutes: 420, bedMinutes: nil), .wake)
+    }
+
+    func testWakeWindowExcludesOneMinuteBeforeStart() {
+        XCTAssertEqual(resolve(nowMinutes: 419, wakeMinutes: 420, bedMinutes: nil), .normal)
+    }
+
+    func testWakeWindowExcludesEnd() {
+        XCTAssertEqual(resolve(nowMinutes: 450, wakeMinutes: 420, bedMinutes: nil), .normal)
+    }
+
+    func testSleepWindowIncludesStart() {
+        XCTAssertEqual(resolve(nowMinutes: 1_320, wakeMinutes: nil, bedMinutes: 1_380), .sleep)
+    }
+
+    func testSleepWindowExcludesEnd() {
+        XCTAssertEqual(resolve(nowMinutes: 1_380, wakeMinutes: nil, bedMinutes: 1_380), .normal)
+    }
+
+    func testWakeWindowWrapsAcrossMidnight() {
+        XCTAssertEqual(resolve(nowMinutes: 1_430, wakeMinutes: 10, bedMinutes: nil), .wake)
+    }
+
+    func testSleepWindowWrapsAcrossMidnight() {
+        XCTAssertEqual(resolve(nowMinutes: 1_400, wakeMinutes: nil, bedMinutes: 20), .sleep)
+        XCTAssertEqual(resolve(nowMinutes: 10, wakeMinutes: nil, bedMinutes: 20), .sleep)
+    }
+
+    func testWakeTakesPriorityWhenWakeAndSleepWindowsOverlap() {
+        XCTAssertEqual(resolve(nowMinutes: 420, wakeMinutes: 420, bedMinutes: 450), .wake)
+    }
+
+    private func resolve(nowMinutes: Int, wakeMinutes: Int?, bedMinutes: Int?) -> DayTimeContext {
+        DayTimeContext.resolve(
+            now: date(minutes: nowMinutes),
+            wakeMinutes: wakeMinutes,
+            bedMinutes: bedMinutes,
+            calendar: calendar
+        )
+    }
+
+    private func date(minutes: Int) -> Date {
+        DateComponents(
+            calendar: calendar,
+            timeZone: calendar.timeZone,
+            year: 2026,
+            month: 7,
+            day: 9,
+            hour: minutes / 60,
+            minute: minutes % 60
+        ).date!
+    }
+}

diff --git a/ios/DopaBreak/GrayscaleAutomationGuideView.swift b/ios/DopaBreak/GrayscaleAutomationGuideView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d12401985b68ac324ff9c096a97c9a914f9a366c
--- /dev/null
+++ b/ios/DopaBreak/GrayscaleAutomationGuideView.swift
@@ -0,0 +1,140 @@
+import DopaBreakCore
+import SwiftUI
+import UIKit
+
+/// 画面を自動でモノクロにする設定ガイド（doc11 §4e）。
+/// 設定完了はiOSの仕様上検知できないため手順ガイドのみで案内する。
+struct GrayscaleAutomationGuideView: View {
+    let model: AppModel
+    let settingsStore: SettingsStore
+
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 22) {
+                    Text("画面を自動でモノクロにする設定")
+                        .font(.system(size: 28, weight: .black))
+                        .foregroundStyle(DesignTokens.primaryText)
+
+                    Text("ショートカットのオートメーションで 起床・就寝の時刻に合わせて画面の色を自動で切り替えます")
+                        .font(.system(size: 15, weight: .semibold))
+                        .foregroundStyle(DesignTokens.secondaryText)
+                        .lineSpacing(4)
+
+                    Button("ショートカットを開く") {
+                        openShortcutsApp()
+                    }
+                    .buttonStyle(PrimaryButtonStyle())
+
+                    CardContainer {
+                        VStack(alignment: .leading, spacing: 8) {
+                            SmallLabel(text: "なぜモノクロ?")
+                            Text("色のない画面はSNSへの反応を弱めると言われています")
+                                .font(.system(size: 15, weight: .semibold))
+                                .foregroundStyle(DesignTokens.secondaryText)
+                                .lineSpacing(4)
+                        }
+                    }
+
+                    if let wakeTimeText, let bedTimeText {
+                        automationStepsCard(
+                            title: "就寝時刻にモノクロにする",
+                            steps: [
+                                "オートメーションを開く",
+                                "＋を押して時刻を選ぶ",
+                                "就寝時刻 \(bedTimeText) を設定",
+                                "すぐに実行を選ぶ（確認を求めるはオフ）",
+                                "アクションでカラーフィルタを設定を選びモノクロをオンにする"
+                            ]
+                        )
+
+                        automationStepsCard(
+                            title: "起床時刻にモノクロを解除する",
+                            steps: [
+                                "オートメーションを開く",
+                                "＋を押して時刻を選ぶ",
+                                "起床時刻 \(wakeTimeText) を設定",
+                                "すぐに実行を選ぶ（確認を求めるはオフ）",
+                                "モノクロをオフにする"
+                            ]
+                        )
+                    } else {
+                        CardContainer {
+                            Text("先に起床・就寝時刻を設定してください")
+                                .font(.system(size: 15, weight: .semibold))
+                                .foregroundStyle(DesignTokens.secondaryText)
+                        }
+                    }
+
+                    Text("設定完了はiOSの仕様上確認できません。設定後は実際に時刻を待って確認してください。")
+                        .font(.system(size: 14, weight: .medium))
+                        .foregroundStyle(DesignTokens.secondaryText)
+                        .lineSpacing(4)
+                }
+                .padding(.horizontal, 20)
+                .padding(.top, 24)
+                .padding(.bottom, 60)
+            }
+            .dopaScreenBackground()
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .topBarTrailing) {
+                    Button("閉じる") {
+                        dismiss()
+                    }
+                    .foregroundStyle(DesignTokens.secondaryText)
+                }
+            }
+        }
+        .tint(DesignTokens.accent)
+        .preferredColorScheme(.dark)
+    }
+
+    private var wakeTimeText: String? {
+        settingsStore.wakeTimeMinutes.map(timeText)
+    }
+
+    private var bedTimeText: String? {
+        settingsStore.bedTimeMinutes.map(timeText)
+    }
+
+    private func automationStepsCard(title: String, steps: [String]) -> some View {
+        CardContainer {
+            VStack(alignment: .leading, spacing: 14) {
+                SmallLabel(text: title)
+                ForEach(Array(steps.enumerated()), id: \.offset) { offset, step in
+                    numberedStep(offset + 1, step)
+                }
+            }
+        }
+    }
+
+    private func numberedStep(_ index: Int, _ text: String) -> some View {
+        HStack(alignment: .top, spacing: 10) {
+            Text("\(index)")
+                .font(.system(size: 13, weight: .black))
+                .foregroundStyle(DesignTokens.background)
+                .frame(width: 22, height: 22)
+                .background(DesignTokens.accent)
+                .clipShape(Circle())
+
+            Text(text)
+                .font(.system(size: 16, weight: .semibold))
+                .foregroundStyle(DesignTokens.primaryText)
+        }
+    }
+
+    private func timeText(minutes: Int) -> String {
+        let normalized = ((minutes % 1_440) + 1_440) % 1_440
+        return String(format: "%02d:%02d", normalized / 60, normalized % 60)
+    }
+
+    private func openShortcutsApp() {
+        guard let url = URL(string: "shortcuts://") else {
+            return
+        }
+        UIApplication.shared.open(url)
+    }
+}
