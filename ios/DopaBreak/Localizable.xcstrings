    "automation.non_target.body.clamped": {
      "comment": "Screen: Non-target automation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your target list returned to one app because Pro expired. To pause before %@ too, restart Pro. Otherwise, delete this automation to stop opening DopaBreak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proの期限が切れたため、対象は1つに戻りました。%@でも一呼吸置くにはProを再開してください。DopaBreakが勝手に開かないようにするには、この自動化を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 기간이 끝나 대상이 1개로 돌아갔습니다. %@에서도 숨을 고르려면 Pro를 다시 시작해 주세요. DopaBreak가 열리지 않게 하려면 이 자동화를 삭제해 주세요."
          }
        }
      }
    },
    "automation.non_target.body.removed": {
      "comment": "Screen: Non-target automation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Shortcuts automation remains after removing the app from your targets. Add it back or delete the automation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象から外したあとも、ショートカットの自動化は残っています。対象に戻すか、自動化を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상에서 뺀 뒤에도 단축어 자동화가 남아 있습니다. 대상에 다시 추가하거나 자동화를 삭제해 주세요."
          }
        }
      }
    },
    "automation.non_target.body.removed_swap": {
      "comment": "Screen: Non-target automation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Shortcuts automation remains after removing the app from your targets. Your current target is %1$@. Swapping removes %2$@ from your targets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象から外したあとも、ショートカットの自動化は残っています。いま対象になっているのは%1$@です。入れ替えると、%2$@は対象から外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상에서 뺀 뒤에도 단축어 자동화가 남아 있습니다. 지금 대상은 %1$@입니다. 교체하면 %2$@ 대신 이 앱이 대상이 됩니다."
          }
        }
      }
    },
    "automation.non_target.body.removed_swap_generic": {
      "comment": "Screen: Non-target automation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Shortcuts automation remains after removing the app from your targets. Swapping removes your current target app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象から外したあとも、ショートカットの自動化は残っています。入れ替えると、いま対象になっているアプリは外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상에서 뺀 뒤에도 단축어 자동화가 남아 있습니다. 교체하면 지금 대상인 앱이 빠집니다."
          }
        }
      }
    },
