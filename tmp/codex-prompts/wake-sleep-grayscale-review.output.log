   629	    private var versionText: String {
   630	        let shortVersion = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String
   631	        let build = Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String
   632	
   633	        switch (shortVersion, build) {
   634	        case let (shortVersion?, build?):
   635	            return "\(shortVersion) (\(build))"
   636	        case let (shortVersion?, nil):
   637	            return shortVersion
   638	        default:
   639	            return "1.0"
   640	        }
   641	    }
   642	}

