    96	    }
    97	
    98	    func start() {
    99	        guard let engine = model.interventionEngine else {
   100	            stage = .failed("記録データを準備できませんでした")
   101	            return
   102	        }
   103	        do {
   104	            let rule = try model.ruleStore.catalogTargetRule(for: target)
   105	            ruleId = rule.id
   106	
   107	            let current = try engine.currentStep()
   108	            let resumable: Set<InterventionStep> = [.idle, .cancelled, .postUseReflection]
   109	            if !resumable.contains(current) {
   110	                try engine.resetToIdle()
   111	            }
   112	            try engine.beginIntervention(ruleId: rule.id)
   113	            try engine.advanceStep() // shieldPresented -> breathing
   114	            beginBreathing()
   115	        } catch {
   116	            stage = .failed("準備できませんでした")
   117	        }
   118	    }
   119	
   120	    func stop() {
   121	        breathTask?.cancel()
   122	        breathTask = nil
   123	    }
   124	
   125	    private func beginBreathing() {
   126	        breathTask?.cancel()
   127	        let total = settingsStore.breathDurationSeconds
   128	        breathRemainingSeconds = total
   129	        stage = .breathing
   130	
   131	        breathTask = Task { [weak self] in
   132	            var remaining = total
   133	            while remaining > 0 {
   134	                if Task.isCancelled { return }
   135	                self?.breathRemainingSeconds = remaining
   136	                try? await Task.sleep(nanoseconds: 1_000_000_000)
   137	                remaining -= 1
   138	            }
   139	            if Task.isCancelled { return }
   140	            self?.advanceToUsageSummary()
   141	        }
   142	    }
   143	
   144	    private func advanceToUsageSummary() {
   145	        guard let engine = model.interventionEngine else {
   146	            stage = .failed("記録データを準備できませんでした")
   147	            return
   148	        }
   149	        do {
   150	            try engine.advanceStep() // breathing -> usageSummary
   151	            todayAttemptDisplayCount = model.todayAttemptCountForCurrentRule(catalogID: target.catalogID) + 1
   152	            stage = .usageSummary
   153	        } catch {
   154	            stage = .failed("進められませんでした")
   155	        }
   156	    }
   157	
   158	    func advanceToGoalReminder() {
   159	        guard let engine = model.interventionEngine else { return }
   160	        do {
   161	            try engine.advanceStep() // usageSummary -> goalReminder
   162	            stage = .goalReminder
   163	        } catch {
   164	            stage = .failed("進められませんでした")
   165	        }
   166	    }
   167	
   168	    func advanceToReasonSelection() {
   169	        guard let engine = model.interventionEngine else { return }
   170	        do {
   171	            try engine.advanceStep() // goalReminder -> intentSelection
   172	            stage = .reasonSelection
   173	        } catch {
   174	            stage = .failed("進められませんでした")
   175	        }
   176	    }
   177	
   178	    func selectReason(_ reason: InterventionReason) {
   179	        guard let engine = model.interventionEngine else { return }
   180	        do {
   181	            selectedReason = reason
   182	            try engine.recordIntent(reason.intentCategory)
   183	            try engine.advanceStep() // intentSelection -> decision
   184	            stage = .decision
   185	        } catch {
   186	            stage = .failed("進められませんでした")
   187	        }
   188	    }
   189	
   190	    func chooseCancel() {
   191	        guard let engine = model.interventionEngine else { return }
   192	        do {
   193	            try engine.recordCancel()
   194	            model.refresh()
   195	            stage = .win
   196	        } catch {
   197	            stage = .failed("記録できませんでした")
   198	        }
   199	    }
   200	
   201	    func chooseOpenWithTime() {
   202	        stage = .durationSelection
   203	    }
   204	
   205	    func selectDuration(_ duration: InterventionDuration) {
   206	        guard let engine = model.interventionEngine else { return }
   207	        do {
   208	            try engine.recordOpen(durationSeconds: duration.seconds)
   209	            model.refresh()
   210	            scheduleTimeUpNotification(after: duration)
   211	            openTargetApp()
   212	        } catch {
   213	            stage = .failed("記録できませんでした")
   214	        }
   215	    }
   216	
   217	    private func scheduleTimeUpNotification(after duration: InterventionDuration) {
   218	        let content = UNMutableNotificationContent()
   219	        content.title = "そろそろひと休み"
   220	        content.body = "そろそろ\(duration.rawValue)分。見てどうだった？"
   221	        content.sound = .default
   222	
   223	        let trigger = UNTimeIntervalNotificationTrigger(
   224	            timeInterval: TimeInterval(duration.seconds),
   225	            repeats: false
   226	        )
   227	        let request = UNNotificationRequest(
   228	            identifier: "dopabreak.timeup.\(UUID().uuidString)",
   229	            content: content,
   230	            trigger: trigger
   231	        )
   232	        UNUserNotificationCenter.current().add(request)
   233	    }
   234	
   235	    private func openTargetApp() {
   236	        guard let urlScheme = target.urlScheme, let url = URL(string: urlScheme) else {
   237	            stage = .opening(fallbackMessage: "ホームに戻って開き直してください")
   238	            return
   239	        }
   240	
   241	        stage = .opening(fallbackMessage: nil)
   242	        UIApplication.shared.open(url, options: [:]) { [weak self] success in
   243	            guard let self else { return }
   244	            if !success {
   245	                self.stage = .opening(fallbackMessage: "ホームに戻って開き直してください")
   246	            }
   247	        }
   248	    }
   249	}

