        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3ヶ月続きました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3개월째 이어지고 있어요"
          }
        }
      }
    },
    "lock_surface.notification.cancel_save.body": {
      "comment": "Screen: Lock Surface",
