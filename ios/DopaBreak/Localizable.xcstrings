    "settings.gate.automation_note": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pro can show the pause screen without a Shortcuts automation." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Proでは、ショートカットを設定しなくても一呼吸の画面を表示できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Pro에서는 단축어 자동화 없이 숨 고르기 화면을 띄울 수 있어요." } }
      }
