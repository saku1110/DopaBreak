    "settings.night_only.description": {
      "comment": "Screen: Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you block stay locked from bedtime until wake-up time. They open normally during the day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全にブロックするアプリは、就寝時刻から起床時刻まで開けません。日中は開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단할 앱은 취침 시각부터 기상 시각까지 열 수 없어요. 낮에는 평소처럼 열려요."
          }
        }
      }
    },
