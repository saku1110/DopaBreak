    "automation_guide.video.body": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded in Shortcuts on iOS 26 using Safari as an example. Choose the app you want to set up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26の実際の設定画面です。Safariを例にしています。自分が設定するアプリに置き換えて進めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 단축어 앱의 실제 설정 화면이에요. Safari를 예로 들었으니 설정하려는 앱으로 바꿔서 따라 하세요."
          }
        }
      }
    },
