   209	    private func dateForTime(minutes: Int?, defaultMinutes: Int) -> Date {
   210	        let calendar = Calendar.current
   211	        let normalized = normalizedMinutes(minutes ?? defaultMinutes)
   212	        let startOfDay = calendar.startOfDay(for: Date())
   213	        return calendar.date(byAdding: .minute, value: normalized, to: startOfDay) ?? Date()
   214	    }
   215	
   216	    private func minutes(from date: Date) -> Int {
   217	        let components = Calendar.current.dateComponents([.hour, .minute], from: date)
   218	        return ((components.hour ?? 0) * 60) + (components.minute ?? 0)
   219	    }
   220	
   221	    private func normalizedMinutes(_ value: Int) -> Int {
   222	        ((value % 1_440) + 1_440) % 1_440
   223	    }
