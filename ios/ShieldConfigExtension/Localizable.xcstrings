{
  "sourceLanguage": "ja",
  "strings": {
    "shield.action.close": {
      "comment": "Screen: Shield",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "shield.night.subtitle": {
      "comment": "Screen: Shield",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens after you wake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きたら開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나면 열 수 있어요"
          }
        }
      }
    },
    "shield.night.title": {
      "comment": "Screen: Shield",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's bedtime"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時間中です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 취침 시간"
          }
        }
      }
    },
    "shield.subtitle.fallback": {
      "comment": "Screen: Shield",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not right now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまは開かない時間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 열지 않는 시간"
          }
        }
      }
    },
    "shield.title": {
      "comment": "Screen: Shield",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Block is on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全ブロック中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전 차단 중"
          }
        }
      }
    },
    "block.shield.manual": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動ブロック あと%lld分"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual block: %lld minutes left"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 차단 %lld분 남음"
          }
        }
      }
    },
    "block.shield.night": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床時刻の%@までブロック"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked until wake-up at %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 시각 %@까지 차단"
          }
        }
      }
    },
    "block.shield.weekly": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定のブロック %@まで"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled block until %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 차단 %@까지"
          }
        }
      }
    },
    "reintervention.shield.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "満足度を振り返って、終了か延長を選びましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflect on how it felt, then finish or add time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만족도를 돌아보고 종료 또는 연장을 선택하세요."
          }
        }
      }
    },
    "reintervention.shield.manual": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知から、またはホーム画面からDopaBreakを開き、終了か延長を選んでください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open DopaBreak from the notification or Home Screen, then finish or add time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 또는 홈 화면에서 DopaBreak를 열어 종료 또는 연장을 선택하세요."
          }
        }
      }
    },
    "reintervention.shield.open": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreakで振り返る"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflect in DopaBreak"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak에서 돌아보기"
          }
        }
      }
    },
    "reintervention.shield.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ利用時間になりました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected usage time is up"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사용 시간이 되었습니다"
          }
        }
      }
    },
    "open_limit.shield.combined_today": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily opens used up until %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の回数を使い切りました %@まで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 횟수를 다 썼어요 %@까지"
          }
        }
      }
    },
    "open_limit.shield.combined_tomorrow": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily opens used up until %@ tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の回数を使い切りました 明日%@まで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 횟수를 다 썼어요 내일 %@까지"
          }
        }
      }
    },
    "open_limit.shield.emergency_hint": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's urgent, wait 30 seconds in DopaBreak to open"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急ぐときはDopaBreakで30秒待つと開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급할 때는 DopaBreak에서 30초 기다리면 열 수 있어요"
          }
        }
      }
    },
    "open_limit.shield.emergency_hint_manual": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's urgent, open DopaBreak and wait 30 seconds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急ぐときはDopaBreakを開いて30秒待つと開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급할 때는 DopaBreak를 열고 30초 기다리면 열 수 있어요"
          }
        }
      }
    },
    "open_limit.shield.open_app": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open DopaBreak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreakを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak 열기"
          }
        }
      }
    },
    "open_limit.shield.title": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened %lld times today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%lld回開きました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %lld번 열었어요"
          }
        }
      }
    },
    "open_limit.shield.until_today": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open until %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ まで開けません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 열 수 없어요"
          }
        }
      }
    },
    "open_limit.shield.until_tomorrow": {
      "comment": "Shield: daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open until %@ tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日 %@ まで開けません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 %@까지 열 수 없어요"
          }
        }
      }
    }
  },
  "version": "1.0"
}
