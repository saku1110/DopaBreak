    "block_picker.category_warning.message": {
      "comment": "Screen: Family activity picker category warning",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every app in the selected category will be blocked. If DopaBreak is in that category, you won't be able to open it during those hours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ分類に入っているアプリがすべて止まります。DopaBreak自身が同じ分類にあると、その時間帯は開けなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 카테고리에 포함된 앱이 모두 차단됩니다. DopaBreak가 같은 카테고리에 있으면 해당 시간대에는 열 수 없습니다."
          }
        }
      }
    },
    "block_picker.category_warning.reselect": {
      "comment": "Screen: Family activity picker category warning",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選び直す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 고르기"
          }
        }
      }
    },
    "block_picker.category_warning.save": {
