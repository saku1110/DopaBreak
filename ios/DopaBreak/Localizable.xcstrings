    "open_limit.settings.footnote": {
      "comment": "Daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you use them up, your blocked apps stay closed until %@ the next morning. If it's urgent, wait 30 seconds to open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い切ると完全にブロックするアプリは翌朝 %@ まで開けません。急ぐときは30秒待てば開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 쓰면 차단할 앱은 다음 날 아침 %@까지 열 수 없어요. 급할 때는 30초 기다리면 열 수 있어요."
          }
        }
      }
    },
    "open_limit.settings.locked": {
      "comment": "Daily open limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the number of opens you set, apps are blocked until the next morning"
