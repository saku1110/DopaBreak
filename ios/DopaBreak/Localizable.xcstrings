    "settings.strict.exit.description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻まで続ける設定です。緊急で必要なときは、30秒待って手動セッションを解除できます。毎週の予定と就寝中のブロックは別に続きます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is set to continue until its end time. In an emergency, wait 30 seconds to end the manual session. Weekly schedules and sleep-time blocks continue separately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시각까지 유지되는 세션입니다. 긴급한 경우 30초를 기다린 후 수동 세션을 해제할 수 있습니다. 주간 일정과 취침 중 차단은 별도로 계속됩니다."
          }
        }
      }
    },
    "settings.strict.exit.done": {
