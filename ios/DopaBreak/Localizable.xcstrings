    "lock_surface.notification.activation.body": {
      "comment": "Screen: Lock Surface",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a pause appears when you open a target app, you're all set. You can check your settings anytime in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリを開き、一呼吸の画面が表示されれば設定完了です。設定はアプリからいつでも確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱을 열 때 숨 고르기 화면이 뜨면 설정이 끝난 거예요. 설정은 앱에서 언제든 확인할 수 있어요."
          }
        }
      }
    },
    "lock_surface.notification.activation.title": {
