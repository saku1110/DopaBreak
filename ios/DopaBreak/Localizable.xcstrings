    "automation_guide.grayscale.label": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Deep Focus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Focus向け"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딥 포커스용"
          }
        }
      }
    },
    "automation_guide.grayscale.lead": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grayscale reduces color-based stimulation. It's an optional setting that works well with Full Block."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を白黒にすると、色による刺激を減らせます。完全ブロックと組み合わせて使える任意の設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 흑백으로 바꾸면 색에서 오는 자극을 줄일 수 있어요. 완전 차단과 함께 쓸 수 있는 선택 설정이에요."
          }
        }
      }
    },
    "automation_guide.grayscale.manual": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you prefer not to automate it: Go to Settings → Accessibility → Accessibility Shortcut → Color Filters and turn it on. After that, triple-click the side button (or the Home button on models that have one) to switch between grayscale and color."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化しない場合は、設定→アクセシビリティ→ショートカット→カラーフィルタをオンにします。以後はサイドボタン（ホームボタンがある機種ではホームボタン）を3回押すと、白黒表示を切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화하지 않는 경우: 설정 → 손쉬운 사용 → 손쉬운 사용 단축키 → 색상 필터를 켜세요. 이후 측면 버튼(홈 버튼이 있는 모델은 홈 버튼)을 세 번 눌러 흑백 화면과 컬러 화면을 전환할 수 있어요."
          }
        }
      }
    },
    "automation_guide.grayscale.mock.apps": {
      "comment": "Screen: Automation Guide",
      "extractionState": "manual",
