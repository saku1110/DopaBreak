          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※他社アプリ(one sec)を対象とした研究です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "※타사 앱(one sec)을 대상으로 한 연구입니다."
          }
        }
      }
    },
    "onboarding.science.dopamine": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social apps run on unpredictable rewards, the same variable-reward design slot machines use. That loop keeps your dopamine circuit firing. Willpower alone can't stop a reflex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SNSは次に何が出るかわからない報酬でドーパミンの回路を刺激し続けます。スロットマシンと同じ変動報酬という設計です。この反射は意志の力では止められません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SNS는 무엇이 나올지 모르는 보상으로 도파민 회로를 계속 자극해요. 슬롯머신과 같은 변동 보상 설계죠. 이 반사는 의지만으로 멈추기 어려워요."
          }
        }
      }
    },
    "onboarding.science.eyebrow": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / The science"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / 科学的背景"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHY IT WORKS / 과학적 배경"
          }
        }
      }
    },
    "onboarding.science.lead": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening on reflex doesn't mean you're weak. Social apps are engineered to trigger that tap before you think."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つい開いてしまうのは、あなたが弱いからではありません。SNSは無意識の起動を狙って設計されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무심코 열게 되는 건 당신이 약해서가 아니에요. SNS는 무의식적인 실행을 노리도록 설계돼 있어요."
          }
        }
      }
    },
    "onboarding.science.mechanism": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak steps in right where that reflex starts and adds one breath of space before the loop takes over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreakはこの回路が自動で回り出す入口に割り込み、ひと呼吸ぶんの間を差し込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak은 반사가 시작되는 순간에 끼어들어 한 호흡만큼의 틈을 만들어요."
          }
        }
      }
    },
    "onboarding.science.principle1.detail": {
      "comment": "Screen: Onboarding",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a beat before the reflex tap"
