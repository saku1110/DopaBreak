    "paywall.legal.annual_intro": {
      "comment": "Screen: Paywall",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %@, then %@/year. Renews automatically. Cancel anytime. Billed to your Apple ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の無料期間終了後、年額%@で自動更新。いつでも解約できます。購入はApple IDに請求されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 무료 체험 종료 후 연 %@에 자동 갱신됩니다. 언제든 해지할 수 있습니다. Apple ID로 청구됩니다"
          }
        }
      }
    },
