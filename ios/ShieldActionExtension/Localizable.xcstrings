    "gate.notification.unlock.body": {
      "comment": "Notification: Gate unlock",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a breath in DopaBreak, then open the app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreakで一呼吸すると、このアプリを開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak에서 숨을 고른 뒤 앱을 열어요"
          }
        }
      }
    },
    "gate.notification.unlock.title": {
      "comment": "Notification: Gate unlock",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to take a breath"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして一呼吸する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 숨 고르기"
          }
        }
      }
    }
