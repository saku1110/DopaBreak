    "lock_surface.notification.annual_offer.body": {
      "comment": "Screen: Lock Surface",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't open %lld times. The annual plan lowers your monthly cost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここまでに%lld回、開かずにすみました。年額プランなら、月額プランより1か月あたりの料金を抑えられます。"
          }
