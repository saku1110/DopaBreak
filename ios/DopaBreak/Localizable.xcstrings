    "home.automation_status.body": {
      "comment": "Screen: Home",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is done once a breath appears when you open a target app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリを開いたときに一呼吸が出れば設定完了です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱을 열 때 숨 고르기가 뜨면 설정 완료예요."
          }
        }
      }
    },
