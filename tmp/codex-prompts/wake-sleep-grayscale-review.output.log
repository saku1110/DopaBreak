   470	    private func saveActivitySelection() {
   471	        let isSelectionEmpty = activitySelection.applicationTokens.isEmpty
   472	            && activitySelection.categoryTokens.isEmpty
   473	            && activitySelection.webDomainTokens.isEmpty
   474	
   475	        if shouldShowPaywallForSelectedTargets(isSelectionEmpty: isSelectionEmpty) {
   476	            activitySelection = currentActivitySelection()
   477	            isPaywallPresented = true
   478	            return
   479	        }
   480	
   481	        do {
   482	            if let rule = primaryRule {
   483	                if isSelectionEmpty {
   484	                    settingsStore.pendingInterventionMode = modeAllowedForCurrentEntitlement(selectedMode).rawValue
   485	                    try model.ruleStore.deleteRule(id: rule.id)
   486	                } else {
   487	                    let mode = modeAllowedForCurrentEntitlement(selectedMode)
   488	                    let data = try JSONEncoder().encode(activitySelection)
   489	                    try model.ruleStore.saveFamilyActivitySelection(
   490	                        data,
   491	                        name: rule.name,
   492	                        mode: mode,
   493	                        defaultDurationMinutes: rule.defaultDurationMinutes,
   494	                        ruleId: rule.id
   495	                    )
   496	                }
   497	            } else if !isSelectionEmpty {
   498	                let mode = modeAllowedForCurrentEntitlement(pendingMode)
   499	                settingsStore.pendingInterventionMode = mode.rawValue
   500	                let data = try JSONEncoder().encode(activitySelection)
   501	                try model.ruleStore.saveFamilyActivitySelection(
   502	                    data,
   503	                    name: "SNS",
   504	                    mode: mode
   505	                )
   506	                selectedMode = mode
   507	            }
   508	
   509	            refreshSettingsState()
   510	            model.syncShield()
   511	        } catch CoreError.validation(let message) {
   512	            model.alertMessage = message
   513	        } catch {
   514	            model.alertMessage = "データを保存できませんでした"
   515	        }
   516	    }
   517	
   518	    private func shouldShowPaywallForSelectedTargets(isSelectionEmpty: Bool) -> Bool {
   519	        let gate = model.entitlementGate
   520	
   521	        if !isSelectionEmpty,
   522	           primaryRule == nil,
   523	           !gate.canAddRule(currentCount: rules.count) {
   524	            return true
   525	        }
   526	
   527	        if let limit = gate.targetAppTokensLimit,
   528	           selectedTargetTokenCount(activitySelection) > limit {
   529	            return true
   530	        }
   531	
   532	        return false
   533	    }
   534	
   535	    private func setRuleEnabled(_ isEnabled: Bool) {
   536	        guard let rule = primaryRule else {
   537	            return
   538	        }
   539	
   540	        do {
   541	            if isEnabled {
   542	                if rule.mode == .deepFocus, !model.entitlementGate.strictModeAllowed {
   543	                    try model.ruleStore.updateMode(id: rule.id, mode: .standard)
   544	                    selectedMode = .standard
   545	                }
   546	                try model.ruleStore.enableRule(id: rule.id)
   547	            } else {
   548	                try model.ruleStore.disableRule(id: rule.id)
   549	            }
   550	            refreshSettingsState()
   551	            model.syncShield()
   552	        } catch CoreError.validation(let message) {
   553	            model.alertMessage = message
   554	        } catch {
   555	            model.alertMessage = "データを保存できませんでした"
   556	        }
   557	    }
   558	
   559	    private func setSelectedMode(_ mode: InterventionMode) {
   560	        guard modeAllowedForCurrentEntitlement(mode) == mode else {
   561	            isPaywallPresented = true
   562	            selectedMode = modeAllowedForCurrentEntitlement(primaryRule?.mode ?? pendingMode)
   563	            return
   564	        }
   565	
   566	        selectedMode = mode
   567	
   568	        guard let rule = primaryRule else {
   569	            settingsStore.pendingInterventionMode = mode.rawValue
   570	            return
   571	        }
   572	
   573	        do {
   574	            try model.ruleStore.updateMode(id: rule.id, mode: mode)
   575	            refreshSettingsState()
   576	        } catch CoreError.validation(let message) {
   577	            model.alertMessage = message
   578	        } catch {
   579	            model.alertMessage = "データを保存できませんでした"
   580	        }
   581	    }
   582	
   583	    private func modeAllowedForCurrentEntitlement(_ mode: InterventionMode) -> InterventionMode {
   584	        if mode == .deepFocus, !model.entitlementGate.strictModeAllowed {
   585	            return .standard
   586	        }
   587	        return mode
   588	    }
   589	
   590	    private func currentActivitySelection() -> FamilyActivitySelection {
   591	        guard let rule = primaryRule,
   592	              let selection = try? JSONDecoder().decode(
   593	                FamilyActivitySelection.self,
   594	                from: rule.activitySelectionData
   595	              ) else {
   596	            return FamilyActivitySelection()
   597	        }
   598	        return selection
   599	    }
   600	
   601	    private func selectionCounts(for rule: TargetRule) -> (applications: Int, categories: Int, webDomains: Int) {
   602	        guard let selection = try? JSONDecoder().decode(
   603	            FamilyActivitySelection.self,
   604	            from: rule.activitySelectionData
   605	        ) else {
   606	            return (0, 0, 0)
   607	        }
   608	        return (
   609	            selection.applicationTokens.count,
   610	            selection.categoryTokens.count,
   611	            selection.webDomainTokens.count
   612	        )
   613	    }
   614	
   615	    private func selectedTargetTokenCount(_ selection: FamilyActivitySelection) -> Int {
   616	        selection.applicationTokens.count
   617	            + selection.categoryTokens.count
   618	            + selection.webDomainTokens.count
   619	    }
   620	
   621	    private var pendingMode: InterventionMode {
   622	        guard let rawValue = settingsStore.pendingInterventionMode,
   623	              let mode = InterventionMode(rawValue: rawValue) else {
   624	            return .standard
   625	        }
   626	        return mode
   627	    }
