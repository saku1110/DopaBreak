   385	    func testSQLiteStoreConcurrentInsertsFromTwoQueues() throws {
   386	        let containerURL = try makeTemporaryDirectory()
   387	        let provider = FixedContainer(url: containerURL)
   388	        let firstStore = try SQLiteLogStore(containerProvider: provider)
   389	        let secondStore = try SQLiteLogStore(containerProvider: provider)
   390	        let group = DispatchGroup()
   391	        let errorLock = NSLock()
   392	        var errors: [Error] = []
   393	
   394	        for queueIndex in 0..<2 {
   395	            group.enter()
   396	            DispatchQueue(label: "DopaBreakCoreTests.concurrent.\(queueIndex)").async {
   397	                defer { group.leave() }
   398	                do {
   399	                    let store = queueIndex == 0 ? firstStore : secondStore
   400	                    for index in 0..<100 {
   401	                        let id = 1000 + queueIndex * 100 + index
   402	                        try store.insert(self.sampleAttempt(id: id, startedAt: self.date(id)))
   403	                    }
   404	                } catch {
   405	                    errorLock.lock()
   406	                    errors.append(error)
   407	                    errorLock.unlock()
   408	                }
   409	            }
   410	        }
   411	
   412	        XCTAssertEqual(group.wait(timeout: .now() + 10), .success)
   413	        XCTAssertTrue(errors.isEmpty, "\(errors)")
   414	        XCTAssertEqual(try firstStore.fetchAttempts().count, 200)
   415	    }
