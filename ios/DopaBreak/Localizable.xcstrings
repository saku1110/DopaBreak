    "reintervention.setup.description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用目的に合わせて、選んだ時間で確認通知またはブロックを行います。必要な用事は通知が基本で、ブロックした場合は戻って振り返れます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a check-in or a block based on your purpose. Necessary tasks default to a notification. After a block, return to reflect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용 목적에 맞춰 선택한 시간에 확인 알림을 보내거나 차단합니다. 필요한 일은 알림이 기본이며 차단된 뒤에는 앱으로 돌아와 돌아볼 수 있습니다."
          }
        }
      }
    },
