    "block_picker.category_warning.title": {
      "comment": "Screen: Family activity picker category warning",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories block everything in them"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリはまとめて止まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 통째로 차단합니다"
          }
        }
      }
    },
    "block_picker.footer": {
      "comment": "Screen: Family activity picker",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't select DopaBreak itself. If you do, you won't be able to open it during those hours. Selecting a category blocks every app in it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak自身は選ばないでください。指定した時間帯にDopaBreakを開けなくなります。カテゴリを選ぶと、その分類のアプリがすべてブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DopaBreak는 선택하지 마세요. 선택하면 해당 시간대에는 DopaBreak를 열 수 없습니다. 카테고리를 선택하면 해당 분류의 앱이 모두 차단됩니다."
          }
        }
      }
    },
